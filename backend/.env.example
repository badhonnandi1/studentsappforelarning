# Copy to .env for local runs. Placeholders only: never commit real secrets.
# Ports match docker-compose.yml / scripts/dev_services.sh.

# App
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000
MIN_APP_VERSION=1.0.0

# Database
DATABASE_URL=postgresql+asyncpg://app_rw:app_rw@127.0.0.1:55432/studyplatform
DATABASE_MIGRATOR_URL=postgresql+asyncpg://app_migrator:app_migrator@127.0.0.1:55432/studyplatform
DB_POOL_MODE=direct
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=5000

# Redis
REDIS_URL=redis://127.0.0.1:56379/0

# Auth: generate local values with `uv run python scripts/dev_keys.py`
JWT_PRIVATE_KEYS={"local-1":"-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"}
JWT_ACTIVE_KID=local-1
# Verify-only deployables (exam-ingest) get public keys instead of private ones.
JWT_PUBLIC_KEYS={}
OTP_HASH_KEY=replace-me-with-32-random-bytes-base64
PII_HASH_KEYS={"phone":"replace-me","email":"replace-me","ip":"replace-me","device":"replace-me"}
KMS_BACKEND=local
KMS_KEY_ID=local
LOCAL_KMS_KEY=replace-me-with-32-random-bytes-base64
# Data keys wrapped by KMS, base64. Empty locally means a fixed local-only key.
PII_DATA_KEYS={}
PII_ACTIVE_DATA_KEY=

# Social sign-in
GOOGLE_ENABLED=false
GOOGLE_CLIENT_IDS=
FACEBOOK_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v27.0

# Staff SSO
STAFF_OIDC_ISSUER=https://accounts.google.com
STAFF_OIDC_CLIENT_ID=
STAFF_OIDC_CLIENT_SECRET=
STAFF_OIDC_ALLOWED_DOMAINS=
STAFF_OIDC_REDIRECT_URIS=
DEV_STAFF_TOKENS=false

# SMS
SMS_BACKEND=fake
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
TEST_PHONE_OTP=

# Storage
S3_ENDPOINT_URL=http://127.0.0.1:59000
S3_BUCKET_UPLOADS=studyplatform-uploads-local
S3_BUCKET_EVENTS=studyplatform-events-local
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=localdev
AWS_SECRET_ACCESS_KEY=localdev-secret

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=studyplatform-api
