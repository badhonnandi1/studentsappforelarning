# Copy to .env for local development: cp .env.example .env
# Every value has a working local default, so the skeleton also starts without a .env file.
# No cloud credentials are needed locally.

# local | test | staging | prod
APP_ENV=local
LOG_LEVEL=INFO
# true = JSON log lines (servers); false = readable console lines (local)
LOG_JSON=false

# PostgreSQL 17, the only system of record (v2 §0.2). Matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Redis: rate limits, quotas, leaderboards, exam locks, caches. Never the system of record.
REDIS_URL=redis://localhost:6379/0

# Exam-answer batches only (v2 §0.2, C9). Everything else uses the Postgres job queue.
# memory = in-process queue for local work; sqs = SQS Standard queue (staging/prod).
EXAM_ANSWER_QUEUE_BACKEND=memory
EXAM_ANSWER_QUEUE_URL=
AWS_REGION=ap-south-1

# AI gateway (v2 §0.4). none = no provider calls; the live integration is deferred.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
