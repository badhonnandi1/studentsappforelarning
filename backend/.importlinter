# import-linter contracts (v2 §2.2). Run: uv run lint-imports
[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:layers]
name = Layers: entrypoints > modules > core > shared (lower layers never import higher ones)
type = layers
layers =
    app.entrypoints
    app.modules
    app.core
    app.shared

[importlinter:contract:exam-ingest-no-postgres]
name = exam-ingest never touches PostgreSQL (v2 §6.2)
type = forbidden
source_modules =
    app.entrypoints.exam_ingest
    app.modules.exam.ingest
forbidden_modules =
    app.core.db
    sqlalchemy
    psycopg
    alembic

[importlinter:contract:auth-internal-private]
name = AUTH internals are private to AUTH
type = forbidden
allow_indirect_imports = True
source_modules =
    app.modules.tax
    app.modules.qb
    app.modules.cms
    app.modules.prac
    app.modules.exam
    app.modules.anl
    app.modules.ai
    app.modules.gam
    app.modules.plan
    app.modules.com
    app.modules.par
    app.modules.inst
    app.modules.pay
    app.modules.ops
    app.modules.nfr
forbidden_modules =
    app.modules.auth.internal

